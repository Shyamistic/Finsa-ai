# ─────────────────────────────────────────────────────────────────────────────
# Finsa AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Amazon Bedrock (Nova Lite — primary LLM) ──────────────────────────────────
# Preferred: use AWS CLI/profile auth (no static keys in .env)
# AWS_PROFILE=default
# Optional fallback: static credentials (only if profile/role auth is unavailable)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: set only when using temporary STS credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ── OpenAI (fallback / embeddings) ───────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_key_here

# ── Anthropic Claude (optional fallback) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key_here

# ── Solana Devnet (audit anchoring — devnet only, never mainnet) ──────────────
# Generate a new keypair: solana-keygen new --outfile finsa-devnet.json
# Fund at: https://faucet.solana.com
SOLANA_PRIVATE_KEY=your_base64_encoded_solana_private_key_here
SOLANA_PUBLIC_KEY=your_solana_public_key_here
SOLANA_NETWORK=devnet

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Docker Compose (inside container): postgresql://lw:lw@postgres:5432/finsa
# Local dev (outside Docker):        postgresql://lw:lw@localhost:5432/finsa
DATABASE_URL=postgresql://lw:lw@localhost:5432/finsa

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose: redis://redis:6379
# Local dev:      redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── GeoIP ─────────────────────────────────────────────────────────────────────
# geoip-lite bundles its own DB — no external key needed in dev
GEOIP_SKIP_IN_DEV=true

# ── API Security ──────────────────────────────────────────────────────────────
# Change these in production — use long random strings
API_KEY=demo-key-finsa-2026
ADMIN_API_KEY=admin-key-finsa-2026-secure

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# ── Demo mode ─────────────────────────────────────────────────────────────────
DEMO_MODE=false
